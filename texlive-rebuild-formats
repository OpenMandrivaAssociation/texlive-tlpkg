#!/bin/bash
# Assemble a fmtutil.cnf from the header plus drop-ins in
# /usr/share/tlpkg/fmtutil.cnf.d/, then build those formats.
#
# Invoked by the texlive-tlpkg file trigger when a format fragment is
# added or removed, and by texlive-rebuild-hyphen after language.dat
# changes (formats embed hyphenation patterns).
#
# fmtutil merges every fmtutil.cnf that kpsewhich finds, including the
# full TeX Live catalogue shipped by texlive-kpathsea. Always pass
# --cnffile so only formats from installed packages are built. The
# assembled file is not named fmtutil.cnf, so a later mktexfmt does not
# merge it back into that catalogue.
set -euo pipefail

TEXMFDIST="${TEXMFDIST:-/usr/share/texmf-dist}"
TEXMFSYSVAR="${TEXMFSYSVAR:-/var/lib/texmf}"
FMT_D="${FMT_D:-/usr/share/tlpkg/fmtutil.cnf.d}"
HDR="${TEXMFDIST}/web2c/fmtutil-hdr.cnf"
OUTDIR="${TEXMFSYSVAR}/web2c"
OUT="${OUTDIR}/fmtutil-installed.cnf"

mkdir -p "${OUTDIR}"

{
	if [ -f "${HDR}" ]; then
		cat "${HDR}"
		echo
	fi
	echo "# ------------------------------------------------------------------"
	echo "# Formats from installed packages (${FMT_D})."
	echo "# Generated by texlive-rebuild-formats; do not edit."
	echo "# ------------------------------------------------------------------"
	if [ -d "${FMT_D}" ]; then
		find "${FMT_D}" -maxdepth 1 -type f ! -name '.*' -print \
			| LC_ALL=C sort \
			| while IFS= read -r f; do
				[ -s "$f" ] || continue
				cat "$f"
				echo
			done
	fi
} > "${OUT}.tmp"
mv -f "${OUT}.tmp" "${OUT}"

# Header and #! lines do not select a format. Nothing to build yet.
if ! grep -Eq '^[^#[:space:]]' "${OUT}"; then
	exit 0
fi

if [ -x /usr/bin/fmtutil-sys ]; then
	# --all, not --missing: a replaced fragment must rebuild an existing
	# fmt. --no-strict so one format whose engine is not installed does
	# not discard the rest. A failed format must not fail the rpm
	# transaction; stderr stays visible.
	/usr/bin/fmtutil-sys --cnffile "${OUT}" --no-strict --all \
		>/dev/null || :
fi

exit 0
